# Controller remapping for smb3pc. Copy to smb3pc.cfg and edit.
# Names are SDL's: key names from SDL_GetKeyName, gamepad buttons as
# SDL_GamepadButton strings (south, east, west, north, back, guide, start,
# leftstick, rightstick, leftshoulder, rightshoulder, dpup, dpdown, dpleft, dpright).
# Buttons: a, b, select, start, up, down, left, right.

key.a = X
key.b = Z
key.select = Right Shift
key.start = Return
key.up = Up
key.down = Down
key.left = Left
key.right = Right

pad.a = south
pad.b = east
pad.select = back
pad.start = start
pad.up = dpup
pad.down = dpdown
pad.left = dpleft
pad.right = dpright
